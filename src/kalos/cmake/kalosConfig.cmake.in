@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(KalosOpenBLAS)
if(@KALOS_WITH_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/kalosTargets.cmake")
check_required_components(kalos)
