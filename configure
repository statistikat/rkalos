#!/bin/sh
# Test the actual R C++17 compiler, including user Makevars overrides. R's
# OpenMP macro can describe its default compiler rather than C++17, so merely
# finding -fopenmp is not enough. Failure selects a working serial build.
set -eu
if test -z "${R_HOME:-}"; then R_HOME=$(R RHOME); fi
r_command="${R_HOME}/bin/R"
if test -x "${r_command}.exe"; then r_command="${r_command}.exe"; fi
platform=$(uname -s)
probe_dir=".rkalos-openmp-$$"
mkdir "$probe_dir"
trap 'rm -rf "$probe_dir"' EXIT HUP INT QUIT TERM
cat > "$probe_dir/Makevars" <<'EOF'
CXX_STD = CXX17
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS)
EOF
cat > "$probe_dir/probe.cpp" <<'EOF'
#ifndef _OPENMP
#error OpenMP is not enabled for the selected C++17 compiler
#endif
#include <omp.h>
static_assert(__cplusplus >= 201703L, "C++17 is required");
extern "C" void rkalos_openmp_probe(int* output) {
    int result = 0;
    const int count = omp_get_max_threads() > 1 ? 2 : 1;
#pragma omp parallel num_threads(count) reduction(+:result)
    result += omp_get_num_threads();
    *output = result;
}
EOF
extension=$("$r_command" --vanilla --slave -e 'cat(.Platform$dynlib.ext)')
openmp_flags=''
if (cd "$probe_dir" && "$r_command" CMD SHLIB --preclean -o "probe$extension" probe.cpp &&
    "$r_command" --vanilla --slave -e 'dyn.load(paste0("probe", .Platform$dynlib.ext)); stopifnot(.C("rkalos_openmp_probe", integer(1))[[1]] >= 1L)') > config.log 2>&1; then
    openmp_flags='$(SHLIB_OPENMP_CXXFLAGS)'
    echo 'rkalos: C++17 OpenMP compile/link/runtime check passed.'
else
    echo 'rkalos: OpenMP unavailable for this C++17 toolchain; using serial execution (see config.log).'
fi
# The vendored core links the OpenBLAS C API provider (src/kalos/backends),
# the exact numerical surface the CMake-qualified core (and with it the JVM
# oracle) is measured on: the LAPACKE/CBLAS headers and symbols must be
# reachable at build and load time. KALOS_OPENBLAS_CPPFLAGS/KALOS_OPENBLAS_LINK
# override the detection wholesale; KALOS_OPENBLAS_ROOT points at an
# installation with include/ and lib/ (static libopenblas.a preferred). There
# is deliberately no fallback to the old F77 shims: silently swapping the
# LAPACK surface re-forks the numerics from the qualified core.
cat > "$probe_dir/capi.cpp" <<'EOF'
#include <cblas.h>
#include <lapacke.h>
static_assert(sizeof(lapack_int) == 4 && sizeof(blasint) == 4, "LP64 OpenBLAS required");
extern "C" void rkalos_capi_probe(int* output) {
    double a[4] = {2., 1., 1., 3.}, b[2] = {1., 2.}, x[2] = {0., 0.};
    double work[512];
    int jpvt[2] = {}, rank = 0;
    cblas_dgemm(CblasColMajor, CblasNoTrans, CblasNoTrans, 2, 1, 2, 1., a, 2, b, 2, 0., x, 2);
    const int info = LAPACKE_dgelsy_work(LAPACK_COL_MAJOR, 2, 2, 1, a, 2, b, 2, jpvt, 1e-13, &rank, work, 512);
    *output = (info == 0 && rank == 2 && x[0] == 4. && openblas_get_config() != nullptr);
}
EOF

openblas_from_root() {
    openblas_root=$1
    capi_cppflags="-isystem \"${openblas_root}/include\""
    if test "$platform" = Darwin && test -f "$openblas_root/lib/libopenblas.dylib"; then
        capi_link="\"$openblas_root/lib/libopenblas.dylib\""
    elif test -f "$openblas_root/lib/libopenblas.a"; then
        flibs=$("$r_command" CMD config FLIBS) || return 1
        capi_link="\"$openblas_root/lib/libopenblas.a\" $flibs -lpthread -lm"
    else
        capi_link="-L\"$openblas_root/lib\" -lopenblas"
    fi
}

probe_openblas() {
    provider=$1
    printf '\nOpenBLAS candidate: %s\n' "$provider" >> config.log
    set -- ''
    # On ELF, bind statically linked LAPACK symbols within the package.
    if test "$platform" != Darwin; then
        set -- '-Wl,--exclude-libs,ALL -Wl,-Bsymbolic' ''
    fi
    for local_bind in "$@"; do
        cat > "$probe_dir/Makevars" <<EOF
CXX_STD = CXX17
PKG_CPPFLAGS = $capi_cppflags
PKG_CXXFLAGS = -ffp-contract=off $openmp_flags
PKG_LIBS = $openmp_flags $capi_link $local_bind
EOF
        if (cd "$probe_dir" && "$r_command" CMD SHLIB --preclean -o "capi$extension" capi.cpp &&
            "$r_command" --vanilla --slave -e 'dyn.load(paste0("capi", .Platform$dynlib.ext)); stopifnot(.C("rkalos_capi_probe", integer(1))[[1]] == 1L)') >> config.log 2>&1; then
            return 0
        fi
    done
    return 1
}

find_openblas() {
    capi_cppflags=${KALOS_OPENBLAS_CPPFLAGS-}
    capi_link=${KALOS_OPENBLAS_LINK-}
    if test -n "$capi_cppflags" || test -n "$capi_link"; then
        capi_link=${capi_link:--lopenblas}
        probe_openblas 'KALOS_OPENBLAS_CPPFLAGS/KALOS_OPENBLAS_LINK'
        return
    fi
    if test -n "${KALOS_OPENBLAS_ROOT-}"; then
        openblas_from_root "$KALOS_OPENBLAS_ROOT" &&
            probe_openblas "KALOS_OPENBLAS_ROOT ($KALOS_OPENBLAS_ROOT)"
        return
    fi

    pkg_config=${PKG_CONFIG:-pkg-config}
    if capi_cppflags=$("$pkg_config" --cflags openblas 2>> config.log) &&
        capi_link=$("$pkg_config" --libs openblas 2>> config.log) &&
        probe_openblas 'pkg-config'; then
        return 0
    fi
    if test "$platform" = Darwin; then
        for brew in "$(command -v brew || :)" /opt/homebrew/bin/brew /usr/local/bin/brew; do
            if test -x "$brew" &&
                prefix=$(HOMEBREW_NO_AUTO_UPDATE=1 "$brew" --prefix --installed openblas 2>> config.log) &&
                test -n "$prefix" &&
                openblas_from_root "$prefix" &&
                probe_openblas "Homebrew ($prefix)"; then
                return 0
            fi
        done
    fi
    capi_cppflags=''
    capi_link='-lopenblas'
    probe_openblas 'system defaults'
}

if ! find_openblas; then
    echo 'rkalos: the OpenBLAS C API (cblas.h/lapacke.h with a linkable' \
         'CBLAS/LAPACKE) required by the vendored core provider is not' \
         'available to this compiler. Install it, or point KALOS_OPENBLAS_ROOT' \
         '(or KALOS_OPENBLAS_CPPFLAGS/KALOS_OPENBLAS_LINK) at an OpenBLAS' \
         'installation; see config.log.' >&2
    if test "$platform" = Darwin; then
        echo "rkalos: With Homebrew, install the provider with 'brew install openblas'." >&2
    fi
    exit 1
fi
printf 'rkalos: OpenBLAS C API check passed using %s.\n' "$provider"
if test -n "$local_bind"; then
    echo 'rkalos: Shared object bound to its own' \
         'LAPACK symbols (no in-process interposition).'
fi

# Stationary-initialization solver seam (M10 adoption of the core's vendored
# SLICOT track, kalos de09063): the eight Fortran members in
# src/kalos/vendor/slicot/ solve the discrete Lyapunov equation through SB03MD
# for state order >= 8 (the pivoted-QR route stays bit-identical below it).
# This mirrors the core's KALOS_WITH_SLICOT build option: ON compiles the
# closure with -ffp-contract=off plus the core's per-source warning
# suppressions and defines KALOS_WITH_SLICOT for every translation unit
# (kalos uses a PRIVATE define on the library; this package is one shared
# object, so the define must cover all objects that link it). There is no
# runtime fallback inside the core: with the closure absent, stationary_
# initialization keeps the QR route for EVERY state order. The probe mirrors
# the OpenMP probe above: the real FC from 'R CMD config FC', the exact vendor
# compile flags, a compile/link/dyn.load/run cycle over the real vendored
# sources with the final PKG_LIBS (OpenBLAS provider first, FLIBS after), and
# a dyn.load(now=TRUE) that binds every external reference of the objects.
# A toolchain without a usable Fortran lane (an MSVC-flavoured R is the known
# case; the core likewise defaults the option OFF on MSVC) falls back to the
# QR-everywhere build with a loud message below.
slicot_fflags='-ffp-contract=off -Wno-compare-reals -Wno-do-subscript -Wno-function-elimination -Wno-maybe-uninitialized -Wno-unused-dummy-argument'
slicot_objects='kalos/vendor/slicot/MB01RD.o kalos/vendor/slicot/SB03MD.o kalos/vendor/slicot/SB03MV.o kalos/vendor/slicot/SB03MW.o kalos/vendor/slicot/SB03MX.o kalos/vendor/slicot/SB03MY.o kalos/vendor/slicot/SB04PX.o kalos/vendor/slicot/select.o'
slicot_define=''
slicot_enabled=false
printf '\nSLICOT seam probe\n' >> config.log
if slicot_fc=$("$r_command" CMD config FC 2>> config.log) && test -n "$slicot_fc" &&
    test -d src/kalos/vendor/slicot; then
    printf 'SLICOT Fortran candidate: FC=%s\n' "$slicot_fc" >> config.log
    mkdir -p "$probe_dir/slicot"
    cp src/kalos/vendor/slicot/MB01RD.f src/kalos/vendor/slicot/SB03MD.f \
       src/kalos/vendor/slicot/SB03MV.f src/kalos/vendor/slicot/SB03MW.f \
       src/kalos/vendor/slicot/SB03MX.f src/kalos/vendor/slicot/SB03MY.f \
       src/kalos/vendor/slicot/SB04PX.f src/kalos/vendor/slicot/select.f \
       "$probe_dir/slicot/"
    cat > "$probe_dir/slicot/probe.f" <<'EOF'
      subroutine rkalos_slicot_probe(order)
      integer order
      order = 8
      end
EOF
    cat > "$probe_dir/slicot/Makevars" <<EOF
FC = $slicot_fc
PKG_FFLAGS = $slicot_fflags
PKG_LIBS = $openmp_flags $capi_link $local_bind
OBJECTS = MB01RD.o SB03MD.o SB03MV.o SB03MW.o SB03MX.o SB03MY.o SB04PX.o select.o probe.o
EOF
    if (cd "$probe_dir/slicot" &&
        "$r_command" CMD SHLIB --preclean -o "slicot$extension" &&
        "$r_command" --vanilla --slave -e 'dyn.load(paste0("slicot", .Platform$dynlib.ext), now = TRUE); stopifnot(.C("rkalos_slicot_probe_", order = 0L)$order == 8L)') >> config.log 2>&1; then
        slicot_define='-DKALOS_WITH_SLICOT'
        slicot_enabled=true
    fi
fi
if test "$slicot_enabled" = true; then
    echo 'rkalos: vendored SLICOT SB03MD closure enabled: stationary' \
         'initialization uses SB03MD for state order >= 8 (QR route below).'
else
    echo 'rkalos: WARNING: Fortran (R CMD config FC) cannot compile and link' \
         'the vendored SLICOT SB03MD closure with this toolchain (see' \
         'config.log). Building WITHOUT it: stationary initialization uses' \
         'the pivoted-QR route for ALL state orders (the core option' \
         'KALOS_WITH_SLICOT=OFF build; numerically qualified upstream).' >&2
    slicot_fflags=''
    slicot_objects=''
fi

escape_sed_replacement() {
    printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}
capi_cppflags=$(escape_sed_replacement "$capi_cppflags")
capi_link=$(escape_sed_replacement "$capi_link")
slicot_fflags=$(escape_sed_replacement "$slicot_fflags")
slicot_objects=$(escape_sed_replacement "$slicot_objects")
slicot_define=$(escape_sed_replacement "$slicot_define")
for makevars in src/Makevars src/Makevars.win; do
    sed -e "s|@OPENMP_FLAGS@|$openmp_flags|g" \
        -e "s|@KALOS_OPENBLAS_CPPFLAGS@|$capi_cppflags|g" \
        -e "s|@KALOS_OPENBLAS_LINK@|$capi_link|g" \
        -e "s|@KALOS_LOCAL_BIND@|$local_bind|g" \
        -e "s|@KALOS_SLICOT_FFLAGS@|$slicot_fflags|g" \
        -e "s|@KALOS_SLICOT_OBJECTS@|$slicot_objects|g" \
        -e "s|@KALOS_SLICOT_DEFINE@|$slicot_define|g" \
        "$makevars.in" > "$makevars"
done
